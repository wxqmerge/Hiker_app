{
  "name": "hiker-server",
  "version": "1.1.4",
  "description": "Hiker Trail App - Node.js/Express backend",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "node ../scripts/compile-shared.js && npx tsc && node ../scripts/patch-shared-imports.js && node ../scripts/flatten-server-dist.js",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.39",
    "tsx": "^4.7.0",
    "typescript": "^5.3.2"
  }
}
